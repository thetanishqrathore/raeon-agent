{
  "description": "Seed eval cases (hand-verified). The full verified set is generated by the hermes-scraper-evalset workflow and written to cases.json.",
  "cases": [
    {
      "id": "books-1",
      "url": "https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html",
      "category": "ecommerce_sandbox",
      "must_include": ["A Light in the Attic", "£51.77", "In stock (22 available)", "Shel Silverstein", "Product Description"],
      "must_exclude": ["Travel", "Mystery", "Historical Fiction", "Sequential Art"],
      "structured_enabled": true,
      "structured_prompt": "Extract the book's title, price, availability, and number available.",
      "structured_schema_json": "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"},\"price\":{\"type\":\"string\"},\"availability\":{\"type\":\"string\"},\"num_available\":{\"type\":\"integer\"}},\"required\":[\"title\",\"price\"]}",
      "structured_expected_json": "{\"title\":\"A Light in the Attic\",\"price\":\"£51.77\",\"num_available\":22}"
    },
    {
      "id": "quotes-1",
      "url": "https://quotes.toscrape.com/",
      "category": "quotes_sandbox",
      "must_include": ["The world as we have created it is a process of our thinking", "Albert Einstein", "J.K. Rowling", "Jane Austen"],
      "must_exclude": ["Login", "Top Ten tags", "Quotes to Scrape"],
      "structured_enabled": true,
      "structured_prompt": "Extract the first three quotes with their author and tags.",
      "structured_schema_json": "{\"type\":\"object\",\"properties\":{\"quotes\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"author\":{\"type\":\"string\"}}}}},\"required\":[\"quotes\"]}",
      "structured_expected_json": "{\"quotes\":[{\"author\":\"Albert Einstein\"},{\"author\":\"J.K. Rowling\"},{\"author\":\"Albert Einstein\"}]}"
    },
    {
      "id": "wikipedia-1",
      "url": "https://en.wikipedia.org/wiki/Markdown",
      "category": "wikipedia",
      "must_include": ["lightweight markup language", "John Gruber", "CommonMark", "plain-text"],
      "must_exclude": ["Jump to content", "Retrieved from", "Privacy policy", "Hidden categories"],
      "structured_enabled": false
    },
    {
      "id": "hackernews-1",
      "url": "https://news.ycombinator.com/item?id=1",
      "category": "hackernews",
      "must_include": ["Y Combinator", "57 points", "pg"],
      "must_exclude": ["Applications are open", "Guidelines"],
      "structured_enabled": false
    },
    {
      "id": "pydocs-1",
      "url": "https://docs.python.org/3/library/functools.html",
      "category": "docs_api",
      "must_include": ["functools", "lru_cache", "reduce", "cached_property"],
      "must_exclude": ["Navigation", "Quick search", "Table of Contents", "Copyright"],
      "structured_enabled": false
    }
  ]
}
