# Raeon Agent runtime environment template.
# Copy the keys you actually use into ${HERMES_HOME:-~/.hermes}/.env.
# Do not commit real credentials.

# --- Search ---
# Brave Search API key: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Optional self-hosted SearXNG instance. The bundled compose file defaults to localhost.
SEARXNG_URL=http://localhost:8888

# Optional provider fallbacks.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# TAVILY_API_KEY=

# --- LLM provider ---
# OpenRouter is convenient for tiered research models, but Hermes supports other providers too.
OPENROUTER_API_KEY=

# --- Optional lead/contact enrichment ---
# HUNTER_API_KEY=
